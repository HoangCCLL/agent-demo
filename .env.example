# Local demo + verification; scripts/setup.sh creates .env from this template
# or fills only these exact placeholder secrets in an existing copied template.
# Shared service VPS: .env.vps.example. Codex clients: .env.client.example.
SEARCH_MCP_PORT=18081
PLAYWRIGHT_MCP_PORT=18082
# Keep loopback for local-only use; use .env.vps.example on the shared MCP VPS.
MCP_BIND_ADDRESS=127.0.0.1
SEARCH_MCP_URL=http://127.0.0.1:18081/mcp
PLAYWRIGHT_MCP_URL=http://127.0.0.1:18082/mcp
SEARCH_MCP_ALLOWED_HOSTS=127.0.0.1:18081,localhost:18081
SEARCH_MCP_ALLOWED_ORIGINS=http://127.0.0.1:18081
MCP_AUTH_TOKEN=replace-with-a-random-token
SEARXNG_SECRET=replace-with-a-random-secret

# Model gateway; scripts/setup.sh replaces both matching gateway placeholders.
LITELLM_BIND_ADDRESS=127.0.0.1
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-replace-with-a-random-gateway-key
# Upstream credentials stay on the service host. Use the real key if LM Studio
# authentication is enabled; otherwise the non-secret dummy value is sufficient.
LMSTUDIO_BASE_URL=http://192.168.110.16:1235/v1
LMSTUDIO_API_KEY=not-needed

# Check the gateway, not LM Studio's namespace-incompatible Responses endpoint.
LLM_BASE_URL=http://127.0.0.1:4000/v1
LLM_API_KEY=sk-replace-with-a-random-gateway-key
LLM_MODEL=qwen/qwen3.8-27b
LLM_CONTINUATION_MODE=input-history
LLM_CONCURRENCY=3
# Client-only: plain `codex` stays on OpenAI; use `codex -p openweight` for LAN mode.
CODEX_PROFILE=openweight

# Leave blank until a real external knowledge corpus exists.
RAG_CORPUS_PATH=
