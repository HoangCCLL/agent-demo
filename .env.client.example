# Client VPS/LAN workstation only: no Docker required here.
# Copy to .env.client, chmod 600, then replace endpoints/token and declarations.
# The MCP + LiteLLM services are installed once using .env.vps.example.
# Clients do not need SEARXNG_SECRET, Docker, or a local Playwright installation.
# 192.0.2.20 is documentation-only; use the shared MCP VPS's LAN IP.
MCP_AUTH_TOKEN=replace-with-token-from-service-operator
SEARCH_MCP_URL=http://192.0.2.20:18081/mcp
PLAYWRIGHT_MCP_URL=http://192.0.2.20:18082/mcp

# Gateway URL, NOT LM Studio's /v1/responses endpoint.
LLM_BASE_URL=http://192.0.2.20:4000/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_CONCURRENCY=3
# Database-free gateway: replay the tool call and output, like Codex does.
LLM_CONTINUATION_MODE=input-history
# Required: actual context limit configured on your server (tokens).
# 32768 is an example, not the advertised maximum of this model.
LLM_CONTEXT_WINDOW=32768
# Required: set true only after the real screenshot/input_image gate passes.
LLM_SUPPORTS_IMAGE=false
# Required for this gateway: copy LITELLM_MASTER_KEY from the service operator.
# This trusted-demo admin key is NOT LMSTUDIO_API_KEY or your OpenAI key.
# Never written into generated config/catalog.
LLM_API_KEY=sk-replace-with-gateway-key-from-service-operator

# Plain `codex` uses OpenAI; `codex -p openweight` selects this LAN profile.
CODEX_PROFILE=openweight
