# Shared MCP + LiteLLM service VPS; use the existing compose.yaml.
# Copy to .env.vps with mode 600. See docs/phase11-runbook.md, section 2.
# 192.0.2.20 is documentation-only: replace it below with this VPS's LAN IP.
# Keep local testing on .env; clients use .env.client, not this file.
MCP_BIND_ADDRESS=192.0.2.20
SEARCH_MCP_PORT=18081
PLAYWRIGHT_MCP_PORT=18082

# Keep the host/origin ports in sync with SEARCH_MCP_PORT.
SEARCH_MCP_ALLOWED_HOSTS=192.0.2.20:18081
SEARCH_MCP_ALLOWED_ORIGINS=http://192.0.2.20:18081

# Generate three independent secrets; do not deploy these placeholder values.
# Share MCP_AUTH_TOKEN and the gateway key with trusted demo clients only.
# LITELLM_MASTER_KEY is admin-level: not a production per-client credential.
MCP_AUTH_TOKEN=replace-with-a-random-token
SEARXNG_SECRET=replace-with-a-random-secret

LITELLM_BIND_ADDRESS=192.0.2.20
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-replace-with-a-random-gateway-key
LLM_MODEL=qwen/qwen3.8-27b
LMSTUDIO_BASE_URL=http://192.168.110.16:1235/v1
# If LM Studio auth is enabled, set its actual API key; never distribute it.
LMSTUDIO_API_KEY=not-needed

# Never share SEARXNG_SECRET or LMSTUDIO_API_KEY. No Codex install on this host.
